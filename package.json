{
  "name": "智采云---企业采购协同管理平台",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:portal": "pnpm --filter @24bid/tenant-portal dev",
    "dev:admin": "pnpm --filter @24bid/platform-admin dev",
    "dev:supplier": "pnpm --filter @24bid/supplier-portal dev",
    "build": "turbo build",
    "build:all": "turbo build",
    "typecheck": "turbo typecheck",
    "typecheck:all": "turbo typecheck",
    "java:dev": "cd backend-java && SPRING_FLYWAY_LOCATIONS='classpath:db/migration,classpath:db/dev' mvn spring-boot:run -Dspring-boot.run.profiles=local",
    "java:smoke": "node scripts/java-local-smoke.mjs",
    "java:workflow-smoke": "node scripts/java-workflow-routing-smoke.mjs",
    "openapi:backend": "node scripts/export-backend-openapi.mjs",
    "openapi:export": "node scripts/export-openapi.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "verify": "node scripts/verify-local.mjs",
    "acceptance:api": "node scripts/portal-api-acceptance.mjs",
    "acceptance:e2e": "playwright test",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/e2e-procurement-loop.sh",
    "e2e": "playwright test",
    "loadtest": "node scripts/loadtest.mjs",
    "loadtest:write": "node scripts/loadtest-write-paths.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
