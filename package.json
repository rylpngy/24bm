{
  "name": "智采云---企业采购协同管理平台",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:portal": "pnpm --filter @24bid/tenant-portal dev",
    "dev:admin": "pnpm --filter @24bid/platform-admin dev",
    "build:all": "turbo build",
    "typecheck:all": "turbo typecheck",
    "legacy:dev": "vite",
    "dev:java": "VITE_JAVA_API_BASE_URL=http://localhost:8080 vite",
    "dev:mock": "VITE_DATA_SOURCE=mock vite",
    "build": "vite build",
    "preview": "vite preview",
    "legacy:api:dev": "node scripts/api-server.mjs",
    "legacy:api:demo": "node scripts/api-demo.mjs",
    "legacy:backend:demo": "node scripts/backend-demo.mjs",
    "java:dev": "cd backend-java && SPRING_FLYWAY_LOCATIONS='classpath:db/migration,classpath:db/dev' mvn spring-boot:run -Dspring-boot.run.profiles=local",
    "java:smoke": "node scripts/java-local-smoke.mjs",
    "openapi:backend": "node scripts/export-backend-openapi.mjs",
    "openapi:export": "node scripts/export-openapi.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "verify": "node scripts/verify-local.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/e2e-procurement-loop.sh",
    "e2e": "playwright test",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@hono/node-server": "^1.19.6",
    "hono": "^4.10.7",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "turbo": "^2.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
