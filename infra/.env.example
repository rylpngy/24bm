# 24Bid 一键部署环境变量样例。复制为 infra/.env 后按环境修改。
# 用法:cd infra && cp .env.example .env && docker compose --profile app --profile portals up -d --build

# ===== 对外访问地址(前端构建期注入,浏览器可达的地址)=====
PUBLIC_API_URL=http://localhost:8080
PUBLIC_KEYCLOAK_URL=http://localhost:8081

# ===== 数据库 / 对象存储凭据(试点环境务必改掉默认值)=====
DB_PASSWORD=procurement
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
GRAFANA_ADMIN_PASSWORD=admin

# ===== 安全基线(试点推荐值)=====
# 关闭演示 JWT 密钥兜底(必须显式配置强密钥或完全走 Keycloak)。
ALLOW_DEMO_JWT_SECRET=false
# 退役自研登录(仅 Keycloak OIDC)。前端 VITE_SELF_LOGIN 同步为 false。
SELF_LOGIN_ENABLED=false
VITE_SELF_LOGIN=false
# CORS 白名单:改为试点环境三端的实际访问地址。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ===== 数据初始化 =====
# 演示环境含 db/demo 种子;干净试点库只跑正式迁移:
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
