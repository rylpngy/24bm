ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine

FROM ${NODE_IMAGE} AS build

ARG VITE_JAVA_API_BASE_URL=""
ARG VITE_KEYCLOAK_URL=""
ARG VITE_SELF_LOGIN=true
ENV VITE_JAVA_API_BASE_URL=$VITE_JAVA_API_BASE_URL \
    VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL \
    VITE_SELF_LOGIN=$VITE_SELF_LOGIN

WORKDIR /workspace
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable \
    && corepack prepare pnpm@9.15.0 --activate \
    && pnpm config set registry https://registry.npmmirror.com

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps/tenant-portal ./apps/tenant-portal

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @24bid/tenant-portal build

FROM ${NGINX_IMAGE}

COPY infra/ludong-poc-prod/portal-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/tenant-portal/dist /usr/share/nginx/html

EXPOSE 80
