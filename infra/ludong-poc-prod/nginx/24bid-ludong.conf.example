map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream ludong_poc_portal {
    server 127.0.0.1:5173;
    keepalive 32;
}

# 如暂时只提供 HTTP，可保留此 server；启用 HTTPS 后也可改为 301 跳转。
server {
    listen 80;
    listen [::]:80;
    server_name ludong-poc.example.edu.cn;

    client_max_body_size 100m;

    # 独立演示域名直接访问根路径时，默认进入鲁东 POC，避免落入通用租户登录页。
    location = / {
        if ($arg_solution = "") {
            return 302 /?solution=ludong-poc;
        }

        proxy_pass http://ludong_poc_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://ludong_poc_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

# 使用 HTTPS 时替换域名和证书路径；未配置证书前请先注释整个 server。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ludong-poc.example.edu.cn;

    ssl_certificate     /etc/nginx/certs/ludong-poc.fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/ludong-poc.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 100m;

    # 独立演示域名直接访问根路径时，默认进入鲁东 POC，避免落入通用租户登录页。
    location = / {
        if ($arg_solution = "") {
            return 302 /?solution=ludong-poc;
        }

        proxy_pass http://ludong_poc_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://ludong_poc_portal;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
