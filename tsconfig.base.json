{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@24bid/shared": ["packages/shared/src/index.ts"],
      "@24bid/shared/*": ["packages/shared/src/*"],
      "@24bid/ui": ["packages/ui/src/index.ts"],
      "@24bid/ui/*": ["packages/ui/src/*"],
      "@24bid/api-client": ["packages/api-client/src/index.ts"],
      "@24bid/api-client/*": ["packages/api-client/src/*"]
    }
  }
}
