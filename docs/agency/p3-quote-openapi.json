{
  "openapi": "3.0.1",
  "info": {
    "title": "24Bid Procurement SaaS API",
    "description": "多租户采购协同管理 SaaS 后端契约（平台 / 采购方 / 供应商三端）。",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Default"
    }
  ],
  "paths": {
    "/api/v1/buyer/agency/evaluation/packages/{pkg}/sessions/{session}/quotes": {
      "get": {
        "tags": [
          "agency-opening-controller"
        ],
        "operationId": "agencyQuoteList",
        "parameters": [
          {
            "name": "pkg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "409": {
            "description": "Conflict",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListAgencyQuoteLayer"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "agency-opening-controller"
        ],
        "operationId": "agencyQuoteAppend",
        "parameters": [
          {
            "name": "pkg",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgencyQuoteDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "409": {
            "description": "Conflict",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAgencyQuoteLayer"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponseAgencyQuoteLayer": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/AgencyQuoteLayer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AgencyQuoteLayer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "participationId": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "format": "int32"
          },
          "previousId": {
            "type": "string"
          },
          "originalAmount": {
            "type": "string"
          },
          "correctedAmount": {
            "type": "string"
          },
          "evaluationAmount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "evidenceVersionId": {
            "type": "string"
          },
          "evidenceHash": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AgencyQuoteDraft": {
        "type": "object",
        "properties": {
          "participationId": {
            "type": "string"
          },
          "expectedPreviousId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "evidenceVersionId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "reviewed": {
            "type": "boolean"
          },
          "idempotencyKey": {
            "type": "string"
          }
        }
      },
      "ApiResponseListAgencyQuoteLayer": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgencyQuoteLayer"
            }
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
