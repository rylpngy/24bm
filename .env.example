# 24Bid 生产环境变量样例 —— 复制为 .env 并按环境覆盖(切勿提交真实密钥)。
# 后端从 application.yml 的 ${ENV:default} 读取;以下为生产必须覆盖的敏感项。

# --- 数据库 ---
DB_URL=jdbc:postgresql://db-host:5432/procurement_saas
DB_USERNAME=procurement
DB_PASSWORD=__CHANGE_ME__

# --- 自研 JWT(开发后备登录;生产走 Keycloak,此密钥仍须改) ---
JWT_SECRET=__CHANGE_ME_AT_LEAST_32_BYTES__
JWT_EXPIRES_IN_SECONDS=7200
# 生产安全收敛:禁用演示密钥回退(缺密钥启动即失败)+ 退役自研签发,Keycloak 唯一签发方。
ALLOW_DEMO_JWT_SECRET=false
SELF_LOGIN_ENABLED=false
# 旧原型 X-Tenant-Id 请求头兜底默认关闭,生产禁止开启。
TENANT_HEADER_FALLBACK_ENABLED=false
# CORS 来源白名单(逗号分隔,生产填真实前端域名)。
CORS_ALLOWED_ORIGINS=https://portal.example.com,https://admin.example.com,https://supplier.example.com

# --- Keycloak(OIDC 主登录) ---
KEYCLOAK_JWK_SET_URI=https://keycloak.example.com/realms/24bid/protocol/openid-connect/certs

# --- MinIO 对象存储 ---
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=__CHANGE_ME__
MINIO_SECRET_KEY=__CHANGE_ME__

# --- 中标通知书电子签章 HMAC 密钥 ---
AWARD_NOTICE_SIGNATURE_SECRET=__CHANGE_ME_AT_LEAST_32_BYTES__

# --- Grafana(可观测性面板,profile=observability) ---
GRAFANA_ADMIN_PASSWORD=__CHANGE_ME__
